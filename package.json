{
  "name": "myleet",
  "version": "1.0.0",
  "description": "Chrome extension to auto-upload accepted LeetCode submissions to GitHub",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); for (const d of ['.plasmo','build']) fs.rmSync(d,{recursive:true,force:true}); console.log('cleaned .plasmo and build')\"",
    "build:clean": "npm run clean && plasmo build"
  },
  "dependencies": {
    "plasmo": "^0.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.292",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "myLeet",
    "version": "1.0.0",
    "description": "Auto-upload accepted LeetCode submissions to GitHub",
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://leetcode.com/*",
      "https://api.github.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    }
  }
}
